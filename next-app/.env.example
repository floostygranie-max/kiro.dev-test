# Database — SQLite for local dev (no setup needed). For prod, use PostgreSQL.
DATABASE_URL="file:./prisma/dev.db"
# DATABASE_URL="postgresql://user:pass@localhost:5432/pustynia"

# NextAuth — generate a secret: `openssl rand -base64 32`
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="CHANGE_ME_IN_PRODUCTION_USE_OPENSSL_RAND"

# Default admin (only used during seed)
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="admin123"
ADMIN_EMAIL="admin@pustynia-bledowska.eu"

# Optional — Cloudinary for image uploads
# CLOUDINARY_CLOUD_NAME=""
# CLOUDINARY_API_KEY=""
# CLOUDINARY_API_SECRET=""
